# Copy to agent/.env (gitignored). Values here are read once at daemon start.

# Apollo.io: Settings -> Integrations -> API Keys. People search needs a *master* key.
# Free plan: 75 credits/month (1 credit per revealed email); search itself is free.
APOLLO_API_KEY=

# Optional. When set together with ANTHROPIC_MODEL (or llm.model in config.json), field
# mapping and outreach drafting call the Anthropic API directly. Otherwise they run through
# the Claude Agent SDK using your Claude Code login, which also powers /autoapply.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional: pin the pairing token instead of the generated agent/state/token.txt (>= 16 chars).
AUTOPILOT_TOKEN=

# Optional: path to a specific `claude` binary if the SDK's bundled one should not be used.
CLAUDE_CODE_PATH=

# debug | info | warn | error
AUTOPILOT_LOG_LEVEL=info
