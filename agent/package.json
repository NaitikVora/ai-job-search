{
  "name": "ai-job-search-autopilot-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local autopilot daemon: runs the repo's /autoapply and /outreach workflows via the Claude Agent SDK and serves the Chrome extension.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "autopilot": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.267",
    "@anthropic-ai/sdk": "^0.124.0",
    "ws": "^8.21.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.0",
    "vitest": "^5.0.0"
  }
}
